# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: (OPTIONAL) GitHub Personal Access Token for higher rate limits (5,000 req/hr vs 60 req/hr).
# If omitted, unauthenticated public GitHub REST API requests are used.
GITHUB_TOKEN=""

# IPINFO_TOKEN: (FREE) IPinfo Lite token for IP ASN, organization, and approximate country data.
IPINFO_TOKEN=""

# ABUSEIPDB_API_KEY: (FREE) AbuseIPDB API v2 key for IP reputation and abuse reporting history checks.
ABUSEIPDB_API_KEY=""

# VIRUSTOTAL_API_KEY: (OPTIONAL) VirusTotal Community API key for passive IP/domain reputation enrichment.
VIRUSTOTAL_API_KEY=""

