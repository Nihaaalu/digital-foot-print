# IPINFO_TOKEN: (FREE) IPinfo Lite token for IP ASN, organization, and approximate country data.
IPINFO_TOKEN=""

# ABUSEIPDB_API_KEY: (FREE) AbuseIPDB API v2 key for IP reputation and abuse reporting history checks.
ABUSEIPDB_API_KEY=""

# VIRUSTOTAL_API_KEY: (OPTIONAL) VirusTotal Community API key for passive IP/domain reputation enrichment.
VIRUSTOTAL_API_KEY=""

# WHOISFREAKS_API_KEY: (FREE - 500 Credits) WhoisFreaks API key for live WHOIS registration intelligence.
WHOISFREAKS_API_KEY=""

